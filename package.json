{
  "name": "allowance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An AI agent's spending account on NEAR. It can pay, but only inside the box, and every move is on the record.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test verifier/replay.test.mjs verifier/live-chain.test.mjs verifier/receipts-doc.test.mjs agent/agent.test.mjs",
    "agent": "node agent/run.mjs --brain claude",
    "agent:compromised": "node agent/run.mjs --brain compromised",
    "agent:gemini": "node agent/run.mjs --brain gemini",
    "test:contract": "cd contract && cargo test",
    "build:contract": "cd contract && cargo near build non-reproducible-wasm --no-abi && node -e \"require('fs').copyFileSync('target/near/allowance.wasm','../deployment/allowance.wasm')\"",
    "demo": "node scripts/demo.mjs",
    "setup": "node scripts/setup-testnet.mjs",
    "prove": "node scripts/prove-the-box.mjs",
    "verify": "node verifier/verify.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "near-api-js": "7.2.0"
  }
}
